---
import type { CollectionEntry } from "astro:content"
import { HugeiconsIcon } from "@hugeicons/react"
import {
  CATEGORY_META,
  COMPLEXITY_META,
  DEFAULT_CATEGORY_META,
} from "@/lib/catalog"

export interface Props {
  item: CollectionEntry<"catalog">
}

const { item } = Astro.props
const { title, category, shortDescription, complexity, timeline } = item.data
const categoryMeta = CATEGORY_META[category as keyof typeof CATEGORY_META] ?? DEFAULT_CATEGORY_META
const complexityMeta = COMPLEXITY_META[complexity]

const artworkThemes: Record<string, { gradient: string; glow: string }> = {
  Websites: {
    gradient: "from-sky-100 via-indigo-50 to-blue-100",
    glow: "bg-sky-400/15",
  },
  "Web Apps": {
    gradient: "from-teal-100 via-emerald-50 to-cyan-100",
    glow: "bg-teal-400/15",
  },
  Dashboards: {
    gradient: "from-violet-100 via-purple-50 to-fuchsia-100",
    glow: "bg-violet-400/15",
  },
  "Mobile Apps": {
    gradient: "from-pink-100 via-rose-50 to-purple-100",
    glow: "bg-pink-400/15",
  },
  "E-commerce": {
    gradient: "from-amber-100 via-orange-50 to-rose-100",
    glow: "bg-amber-400/15",
  },
}

const artwork = artworkThemes[category] ?? artworkThemes.Websites
---

<article class="h-full">
  <a
    href={`/catalog/${item.id}`}
    class="relative flex h-full flex-col overflow-hidden rounded-[1.5rem] border border-slate-200/90 bg-white shadow-[0_14px_32px_rgba(15,23,42,0.06)] transition-colors duration-200 hover:border-slate-300"
  >
    <div class={`relative aspect-[16/11] overflow-hidden rounded-[1.5rem] bg-gradient-to-br ${artwork.gradient}`}>
      <div class={`absolute -right-10 -top-10 size-40 rounded-full ${artwork.glow} blur-3xl`} />
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,rgba(255,255,255,0.62),transparent_40%),linear-gradient(180deg,rgba(255,255,255,0.18),transparent_50%)]" />
      <div class="absolute inset-0 rounded-[1.5rem] ring-1 ring-black/5" />

      <div class="relative flex h-full flex-col justify-between p-4 sm:p-5">
        <div class="flex items-start justify-between gap-3">
          <span class="inline-flex items-center gap-2 rounded-full bg-white/60 px-3 py-1 text-[0.7rem] font-medium uppercase tracking-[0.16em] text-slate-700 backdrop-blur-sm">
            <HugeiconsIcon icon={categoryMeta.icon} size={12} />
            {categoryMeta.label}
          </span>
          <div class="flex size-10 items-center justify-center rounded-2xl bg-white/55 text-slate-700 backdrop-blur-sm">
            <HugeiconsIcon icon={categoryMeta.icon} size={18} />
          </div>
        </div>

        <div class="space-y-2">
          <p class="text-xs font-medium uppercase tracking-[0.18em] text-slate-600">
            {complexity}
          </p>
          <p class="max-w-[16rem] text-sm leading-6 text-slate-700/80">
            {timeline}
          </p>
        </div>
      </div>
    </div>

    <div class="flex flex-1 flex-col px-4 pb-4 pt-3.5 sm:px-5 sm:pb-5">
      <div>
        <h3 class="mt-1 line-clamp-2 text-lg font-semibold tracking-tight text-slate-900 sm:text-[1.15rem] sm:leading-7">
          {title}
        </h3>
        <p class="mt-2 line-clamp-3 text-sm leading-6 text-slate-600">{shortDescription}</p>
      </div>

      <div class="mt-4 flex flex-col gap-2">
        <div class="flex flex-wrap gap-2 text-[0.7rem] font-medium uppercase tracking-[0.16em] text-slate-500">
          <span class="rounded-full bg-slate-100 px-2.5 py-1 text-slate-700">{complexity}</span>
          <span class="rounded-full bg-slate-100 px-2.5 py-1 text-slate-700">{timeline}</span>
        </div>
        <p class="text-sm leading-6 text-slate-500">{complexityMeta.description}</p>
      </div>
    </div>
  </a>
</article>
