---
import { SITE, HEADER_LINKS } from "@/lib/site"

const currentPath = Astro.url.pathname
import { HugeiconsIcon } from "@hugeicons/react"
import ArrowUpRight01Icon from "@hugeicons/core-free-icons/ArrowUpRight01Icon"
import Menu01Icon from "@hugeicons/core-free-icons/Menu01Icon"
import Cancel01Icon from "@hugeicons/core-free-icons/Cancel01Icon"
import GlobeIcon from "@hugeicons/core-free-icons/GlobeIcon"
import InstagramIcon from "@hugeicons/core-free-icons/InstagramIcon"
import NewTwitterIcon from "@hugeicons/core-free-icons/NewTwitterIcon"
import Linkedin01Icon from "@hugeicons/core-free-icons/Linkedin01Icon"

const socialLinks = [
  { href: SITE.social.twitter ?? "#", icon: NewTwitterIcon, label: "Twitter" },
  { href: SITE.social.instagram ?? "#", icon: InstagramIcon, label: "Instagram" },
  { href: SITE.social.linkedin ?? "#", icon: Linkedin01Icon, label: "LinkedIn" },
  { href: "#", icon: GlobeIcon, label: "Website" },
]
---

<header class="sticky top-0 z-50 w-full" data-header>
  <div class="mx-auto max-w-7xl px-4 py-4 sm:px-6">
    <nav
      class="nav-shell flex w-full items-center justify-between gap-3.5 lg:gap-6"
      data-nav
    >
      <a href="/" class="flex items-center gap-2.5">
        <span class="flex size-8 items-center justify-center rounded-full bg-foreground">
          <span class="text-sm font-bold text-background">C</span>
        </span>
        <span class="text-base font-semibold tracking-tight">{SITE.name}</span>
      </a>

      <div class="hidden lg:block">
        <div class="flex items-center gap-1.5">
          {HEADER_LINKS.map((link) => {
            const isActive =
              currentPath === link.href ||
              currentPath === link.href + "/" ||
              (link.href !== "/" && currentPath.startsWith(link.href + "/"))
            return (
              <a
                href={link.href}
                aria-current={isActive ? "page" : undefined}
                class={[
                  "group relative inline-flex items-center justify-center px-3 py-2 text-sm font-medium tracking-tight transition-[color,transform,opacity] duration-300 ease-out focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring/40 focus-visible:ring-offset-2 focus-visible:ring-offset-background",
                  isActive
                    ? "text-foreground"
                    : "text-muted-foreground hover:text-foreground",
                ].join(" ")}
              >
                <span
                  class={[
                    "absolute inset-x-3 -bottom-0.5 h-px origin-center rounded-full bg-foreground/75 transition-transform duration-300 ease-out",
                    isActive ? "scale-x-100" : "scale-x-0 group-hover:scale-x-100",
                  ].join(" ")}
                  aria-hidden="true"
                />
                <span
                  class={[
                    "relative z-10 transition-transform duration-300 ease-out",
                    isActive ? "" : "group-hover:-translate-y-px",
                  ].join(" ")}
                >
                  {link.label}
                </span>
              </a>
            )
          })}
        </div>
      </div>

      <a
        href="/contact"
        class="group relative hidden h-10 w-fit items-center gap-2 overflow-hidden rounded-full bg-foreground pl-4 pr-12 text-sm font-medium text-background transition-all duration-500 hover:pl-12 hover:pr-4 lg:inline-flex"
      >
        <span class="relative z-10">Let's Collaborate</span>
        <span class="absolute right-1 flex size-8 items-center justify-center rounded-full bg-background/20 text-background transition-all duration-500 group-hover:right-[calc(100%-36px)] group-hover:rotate-45">
          <HugeiconsIcon icon={ArrowUpRight01Icon} size={16} color="white" />
        </span>
      </a>

      <button
        type="button"
        class="flex size-10 items-center justify-center rounded-full border bg-background shadow-xs lg:hidden"
        aria-label="Open menu"
        aria-expanded="false"
        data-menu-toggle
      >
        <HugeiconsIcon icon={Menu01Icon} size={20} />
      </button>
    </nav>
  </div>
</header>

<div
  data-mobile-overlay
  class="invisible fixed inset-0 z-50 flex translate-y-4 flex-col bg-background opacity-0 transition-all duration-300 data-[open]:visible data-[open]:translate-y-0 data-[open]:opacity-100"
>
  <div class="flex items-center justify-between px-4 py-3 sm:px-6">
    <a href="/" class="flex items-center gap-2.5">
      <span class="flex size-8 items-center justify-center rounded-full bg-foreground">
        <span class="text-sm font-bold text-background">C</span>
      </span>
      <span class="text-base font-semibold tracking-tight">{SITE.name}</span>
    </a>
    <button
      type="button"
      class="flex size-10 items-center justify-center rounded-full border bg-background shadow-xs"
      aria-label="Close menu"
      data-menu-close
    >
      <HugeiconsIcon icon={Cancel01Icon} size={20} />
    </button>
  </div>

  <div class="flex flex-1 flex-col justify-center px-8">
    <ul class="flex flex-col gap-6">
      {HEADER_LINKS.map((link) => (
        <li>
          <a
            href={link.href}
            aria-current={currentPath === link.href || currentPath === link.href + "/" || (link.href !== "/" && currentPath.startsWith(link.href + "/")) ? "page" : undefined}
            class="text-3xl font-semibold tracking-tight text-foreground transition-colors duration-300 hover:text-muted-foreground"
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <div class="mt-12">
      <a
        href="/contact"
        class="group relative inline-flex h-12 w-fit items-center gap-3 overflow-hidden rounded-full bg-foreground pl-6 pr-14 text-base font-medium text-background transition-all duration-500 hover:pl-14 hover:pr-6"
      >
        <span class="relative z-10">Let's collaborate</span>
        <span class="absolute right-2 flex size-8 items-center justify-center rounded-full bg-background/20 text-background transition-all duration-500 group-hover:right-[calc(100%-44px)] group-hover:rotate-45">
          <HugeiconsIcon icon={ArrowUpRight01Icon} size={16} color="white" />
        </span>
      </a>
    </div>
  </div>

  <div class="px-8 pb-8">
    <div class="mb-6 flex items-center gap-3">
      {socialLinks.map((link) => (
        <a
          href={link.href}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={link.label}
          class="flex size-10 items-center justify-center rounded-full border bg-background text-muted-foreground shadow-xs transition-colors hover:text-foreground"
        >
          <HugeiconsIcon icon={link.icon} size={18} />
        </a>
      ))}
    </div>
    <p class="text-sm text-muted-foreground">&copy; 2026 {SITE.name}</p>
  </div>
</div>

<style>
  .nav-shell {
    position: relative;
    border: 1px solid transparent;
    border-radius: 1.75rem;
    background: transparent;
    box-shadow: none;
    padding: 0;
    transition:
      background-color 500ms ease,
      border-color 500ms ease,
      box-shadow 500ms ease,
      backdrop-filter 500ms ease,
      -webkit-backdrop-filter 500ms ease,
      padding 500ms ease,
      transform 500ms ease;
  }

  .nav-shell::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    opacity: 0;
    pointer-events: none;
    transition: opacity 500ms ease;
  }

  .nav-shell[data-floating] {
    border-color: rgba(148, 163, 184, 0.18);
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.52), rgba(255, 255, 255, 0.28)),
      linear-gradient(135deg, rgba(255, 255, 255, 0.42), rgba(255, 255, 255, 0.12));
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.5),
      inset 0 -1px 0 rgba(255, 255, 255, 0.28),
      0 18px 40px -24px rgba(15, 23, 42, 0.32),
      0 10px 24px -18px rgba(15, 23, 42, 0.2);
    backdrop-filter: blur(16px) saturate(140%);
    -webkit-backdrop-filter: blur(16px) saturate(140%);
    padding: 0.625rem;
  }

  .nav-shell[data-floating]::before {
    opacity: 1;
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.35), transparent 55%);
  }
  @media (prefers-reduced-motion: reduce) {
    .nav-shell,
    .nav-shell::before {
      transition: none;
    }
  }
</style>

<script>
  const nav = document.querySelector("[data-nav]")
  const toggle = document.querySelector("[data-menu-toggle]")
  const overlay = document.querySelector("[data-mobile-overlay]")
  const closeBtn = document.querySelector("[data-menu-close]")
  const body = document.body

  function onScroll() {
    const isSticky = window.scrollY >= 50
    if (isSticky) {
      nav?.setAttribute("data-floating", "")
    } else {
      nav?.removeAttribute("data-floating")
    }
  }

  function openMenu() {
    overlay?.setAttribute("data-open", "")
    body.style.overflow = "hidden"
    toggle?.setAttribute("aria-expanded", "true")
  }

  function closeMenu() {
    overlay?.removeAttribute("data-open")
    body.style.overflow = ""
    toggle?.setAttribute("aria-expanded", "false")
  }

  toggle?.addEventListener("click", () => {
    const isOpen = overlay?.hasAttribute("data-open")
    if (isOpen) {
      closeMenu()
    } else {
      openMenu()
    }
  })

  closeBtn?.addEventListener("click", closeMenu)

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && overlay?.hasAttribute("data-open")) {
      closeMenu()
    }
  })

  function handleResize() {
    if (window.innerWidth >= 1024) closeMenu()
  }

  window.addEventListener("resize", handleResize)
  window.addEventListener("scroll", onScroll, { passive: true })
  onScroll()
</script>
