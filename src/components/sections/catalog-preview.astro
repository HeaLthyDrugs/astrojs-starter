---
import { getCollection } from "astro:content"
import { HugeiconsIcon } from "@hugeicons/react"
import ArrowLeft01Icon from "@hugeicons/core-free-icons/ArrowLeft01Icon"
import ArrowRight01Icon from "@hugeicons/core-free-icons/ArrowRight01Icon"
import { SITE } from "@/lib/site"
import { CATEGORY_META, DEFAULT_CATEGORY_META } from "@/lib/catalog"

const allItems = await getCollection("catalog")
const featuredSlugs = [
  "business-website",
  "landing-page",
  "saas-mvp",
  "admin-dashboard",
  "ecommerce-website",
  "mobile-app-mvp",
  "booking-system",
  "portfolio-website",
]
const items = allItems.filter((item) => featuredSlugs.includes(item.id))

type CardVariant = "portrait" | "landscape"

const cardVariants: Record<string, CardVariant> = {
  "business-website": "landscape",
  "landing-page": "portrait",
  "saas-mvp": "landscape",
  "admin-dashboard": "portrait",
  "ecommerce-website": "landscape",
  "mobile-app-mvp": "portrait",
  "booking-system": "landscape",
  "portfolio-website": "portrait",
}

const categoryGradients: Record<string, string> = {
  Websites: "from-sky-200 via-indigo-100 to-blue-100",
  "Web Apps": "from-teal-200 via-emerald-100 to-cyan-100",
  Dashboards: "from-violet-200 via-purple-100 to-fuchsia-100",
  "E-commerce": "from-amber-200 via-orange-100 to-rose-100",
  "Mobile Apps": "from-pink-200 via-rose-100 to-purple-100",
}
---

<section class="py-16 md:py-20" aria-labelledby="catalog-heading" data-catalog-root>
  <div class="">
    <div class="mx-auto max-w-7xl" data-catalog-shell>
      <h2 id="catalog-heading" class="mt-4 text-3xl font-bold tracking-tight md:text-4xl">
        Explore what we can build
      </h2>

      <p class="mt-3 max-w-2xl text-base leading-relaxed text-muted-foreground">
        {SITE.copy.catalogPreviewDescription}
      </p>
    </div>
  </div>

  <div
    class="group/carousel relative mt-12"
    style="width: 100vw; margin-left: calc(-50vw + 50%); --catalog-start-offset: 0px; --catalog-end-offset: 0px; --catalog-gap: 1rem;"
  >
    <div
      class="flex gap-4 snap-x snap-mandatory scroll-smooth overflow-x-auto [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
      data-catalog-track
      role="region"
      aria-label="Catalog items carousel"
      tabindex="0"
    >
      <div
        aria-hidden="true"
        class="shrink-0 snap-start"
        style="width: max(calc(var(--catalog-start-offset) - var(--catalog-gap)), 0px);"
      />

      {
        items.map((item) => {
          const variant = cardVariants[item.id] ?? "portrait"
          const category = item.data.category
          const categoryMeta =
            CATEGORY_META[category as keyof typeof CATEGORY_META] ?? DEFAULT_CATEGORY_META
          const gradient = categoryGradients[category] ?? categoryGradients.Websites
          const isLandscape = variant === "landscape"
          const href = `/catalog/${item.id}`

          return (
            <article
              class="catalog-card group/card relative shrink-0 snap-start overflow-hidden rounded-3xl"
              class:list={[
                isLandscape
                  ? "w-[min(82vw,360px)] aspect-[2/3] md:w-[min(40vw,620px)] md:h-[540px] md:aspect-auto"
                  : "w-[min(72vw,300px)] aspect-[3/5] md:w-[min(24vw,340px)] md:h-[540px] md:aspect-auto",
              ]}
              data-catalog-card
            >
              <a
                href={href}
                class="relative block h-full w-full focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
              >
                <div class="absolute inset-0 bg-gradient-to-br" class:list={[gradient]} />
                <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,rgba(255,255,255,0.55),transparent_42%),radial-gradient(circle_at_bottom_left,rgba(255,255,255,0.25),transparent_28%)]" />
                <div class="pointer-events-none absolute inset-0 rounded-3xl inset-ring-1 inset-ring-black/10 dark:inset-ring-white/10" />

                <div class="relative flex h-full flex-col justify-between p-5 md:p-7">
                  <div class="flex items-start justify-between gap-4">
                    <div class="max-w-[12rem]">
                      <span class="inline-flex items-center gap-2 rounded-full bg-white/20 px-3 py-1 text-[11px] font-medium uppercase tracking-wider text-white/90 backdrop-blur-[2px]">
                        <HugeiconsIcon icon={categoryMeta.icon} size={12} />
                        {item.data.category}
                      </span>
                      <h3 class="mt-3 text-lg font-semibold leading-snug text-white md:text-xl">
                        {item.data.title}
                      </h3>
                    </div>
                    <div class="flex size-12 shrink-0 items-center justify-center rounded-2xl bg-white/15 text-white/90 backdrop-blur-[2px]">
                      <HugeiconsIcon icon={categoryMeta.icon} size={20} />
                    </div>
                  </div>

                  <div class="space-y-4">
                    {isLandscape && (
                      <p class="max-w-xs text-sm leading-relaxed text-white/80 line-clamp-3">
                        {item.data.shortDescription}
                      </p>
                    )}

                    <div class="flex items-end justify-between gap-4">
                      <div class="space-y-1">
                        <p class="text-[0.7rem] font-medium uppercase tracking-[0.16em] text-white/70">
                          {item.data.complexity}
                        </p>
                        <p class="text-sm leading-6 text-white/70">{item.data.timeline}</p>
                      </div>
                      <span class="inline-flex items-center gap-1 text-sm font-medium text-white/80 transition-colors group-hover/card:text-white">
                        View details &rarr;
                      </span>
                    </div>
                  </div>
                </div>
              </a>
            </article>
          )
        })
      }

      <div
        aria-hidden="true"
        class="shrink-0"
        style="width: max(calc(var(--catalog-end-offset) - var(--catalog-gap)), 0px);"
      />
    </div>
  </div>

  <div class="mt-8 px-4 sm:px-6 lg:px-8">
    <div class="mx-auto flex max-w-7xl items-center justify-end gap-3">
      <a href="/catalog" class="mr-auto text-sm font-medium text-muted-foreground transition-colors hover:text-foreground">
        Browse full catalog &rarr;
      </a>

      <div class="flex items-center gap-2">
        <button
          type="button"
          class="flex size-10 items-center justify-center rounded-full border border-border bg-background text-muted-foreground transition-all hover:bg-muted hover:text-foreground"
          aria-label="Previous catalog items"
          data-catalog-prev
        >
          <HugeiconsIcon icon={ArrowLeft01Icon} size={18} />
        </button>

        <button
          type="button"
          class="flex size-10 items-center justify-center rounded-full border border-border bg-background text-muted-foreground transition-all hover:bg-muted hover:text-foreground"
          aria-label="Next catalog items"
          data-catalog-next
        >
          <HugeiconsIcon icon={ArrowRight01Icon} size={18} />
        </button>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  const root = /** @type {HTMLElement | null} */ (
    document.querySelector("[data-catalog-root]")
  )

  if (root) {
    const shell = /** @type {HTMLElement | null} */ (
      root.querySelector("[data-catalog-shell]")
    )
    const track = /** @type {HTMLElement | null} */ (
      root.querySelector("[data-catalog-track]")
    )
    const prevBtn = /** @type {HTMLButtonElement | null} */ (
      root.querySelector("[data-catalog-prev]")
    )
    const nextBtn = /** @type {HTMLButtonElement | null} */ (
      root.querySelector("[data-catalog-next]")
    )
    const cards = /** @type {HTMLElement[]} */ (
      Array.from(root.querySelectorAll("[data-catalog-card]"))
    )
    let snapPositions = [0]

    function syncOffsets() {
      if (!shell || !track) return

      const shellRect = shell.getBoundingClientRect()
      const startOffset = Math.max(shellRect.left, 0)
      const endOffset = Math.max(window.innerWidth - shellRect.right, 0)

      track.style.setProperty("--catalog-start-offset", `${startOffset}px`)
      track.style.setProperty("--catalog-end-offset", `${endOffset}px`)

      snapPositions = [0, ...cards.slice(1).map((card) => card.offsetLeft)]

      if (track.scrollLeft <= 2) {
        track.scrollLeft = 0
      }
    }

    function getCurrentStep() {
      if (!track) return 0

      return snapPositions.reduce((closestIndex, position, index) => {
        const closestDistance = Math.abs(snapPositions[closestIndex] - track.scrollLeft)
        const distance = Math.abs(position - track.scrollLeft)

        return distance < closestDistance ? index : closestIndex
      }, 0)
    }

    /**
     * @param {number} direction
     */
    function scrollToStep(direction) {
      if (!track || snapPositions.length === 0) return

      const currentStep = getCurrentStep()
      const nextStep = Math.min(Math.max(currentStep + direction, 0), snapPositions.length - 1)

      track.scrollTo({
        left: snapPositions[nextStep],
        behavior: "smooth",
      })
    }

    syncOffsets()
    window.addEventListener("resize", syncOffsets)

    prevBtn?.addEventListener("click", () => scrollToStep(-1))
    nextBtn?.addEventListener("click", () => scrollToStep(1))

    /**
     * @param {KeyboardEvent} e
     */
    function handleTrackKeydown(e) {
      if (e.key === "ArrowLeft") {
        e.preventDefault()
        scrollToStep(-1)
      }

      if (e.key === "ArrowRight") {
        e.preventDefault()
        scrollToStep(1)
      }
    }

    track?.addEventListener("keydown", handleTrackKeydown)
  }
</script>
