---
import { HugeiconsIcon } from "@hugeicons/react"
import CheckmarkCircle01Icon from "@hugeicons/core-free-icons/CheckmarkCircle01Icon"
import ArrowUpRight01Icon from "@hugeicons/core-free-icons/ArrowUpRight01Icon"

interface Props {
  eyebrow?: string
  title?: string
  benefits?: string[]
  panelTitleLineOne?: string
  panelTitleLineTwo?: string
  primaryHref?: string
  primaryLabel?: string
  secondaryHref?: string
  secondaryLabel?: string
}

const {
  eyebrow = "Built for growing brands",
  title = "Build with clarity and move faster.",
  benefits = ["Flexible builds", "Full-stack delivery", "Reliable support"],
  panelTitleLineOne = "See the catalog.",
  panelTitleLineTwo = "Start the conversation.",
  primaryHref = "/catalog",
  primaryLabel = "Explore the catalog",
  secondaryHref = "/contact",
  secondaryLabel = "Start your project",
} = Astro.props
---

<section
  class="relative -mx-4 overflow-hidden px-4 py-16 sm:-mx-6 sm:px-6 md:py-20 lg:-mx-8 lg:px-8"
>
  <div class="group relative">
    <div
      class="relative min-h-[500px] overflow-hidden rounded-3xl md:min-h-[620px]"
    >
      <div aria-hidden="true" class="absolute inset-0">
        <img
          src="/bg/cta-background.avif"
          alt=""
          class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.02]"
          loading="lazy"
          decoding="async"
          width={3840}
          height={2044}
        />
        <div class="absolute inset-0 bg-black/45" />
      </div>

      <div
        class="relative z-10 flex flex-col items-center px-6 pb-36 pt-20 text-center md:pb-44 md:pt-28"
      >
        {eyebrow && (
          <span class="text-sm font-medium tracking-wide text-white/80">
            {eyebrow}
          </span>
        )}

        <h2
          class="mt-4 max-w-[760px] text-3xl font-bold leading-[1.1] tracking-tight text-white md:text-5xl lg:text-6xl"
        >
          {title}
        </h2>

        <div
          class="mt-8 flex flex-wrap items-center justify-center gap-x-8 gap-y-3"
        >
          {benefits.map((benefit) => (
            <div class="flex items-center gap-2">
              <HugeiconsIcon
                icon={CheckmarkCircle01Icon}
                size={18}
                color="white"
                className="shrink-0 opacity-80"
                aria-hidden="true"
              />
              <span class="text-sm text-white/90">{benefit}</span>
            </div>
          ))}
        </div>
      </div>
    </div>

    <div
      class="relative -mt-28 px-6 md:-mt-32 md:px-12 lg:px-20"
    >
      <div class="rounded-3xl border bg-white p-6 shadow-lg md:p-12">
        <div
          class="flex flex-col items-center gap-6 md:flex-row md:justify-between"
        >
          <div class="text-center md:text-left">
            <p class="text-xl font-bold leading-tight text-foreground md:text-2xl">
              {panelTitleLineOne}
            </p>
            {panelTitleLineTwo && (
              <p class="text-xl font-bold leading-tight text-foreground md:text-2xl">
                {panelTitleLineTwo}
              </p>
            )}
          </div>
          <div class="flex flex-col gap-3 sm:flex-row">
            <a
              href={primaryHref}
              class="inline-flex h-12 cursor-pointer items-center justify-center rounded-full border bg-white px-6 text-sm font-medium text-foreground shadow-sm transition-all duration-300 hover:-translate-y-0.5 hover:bg-gray-50 hover:shadow-md active:translate-y-px"
            >
              {primaryLabel}
            </a>
            <a
              href={secondaryHref}
              class="group inline-flex h-12 w-fit cursor-pointer items-center gap-2 rounded-full bg-foreground pl-6 pr-2 text-sm font-medium text-background shadow-sm transition-all duration-300 hover:-translate-y-0.5 hover:bg-foreground/90 hover:shadow-md active:translate-y-px"
            >
              <span>{secondaryLabel}</span>
              <span class="flex size-8 items-center justify-center rounded-full bg-background/20 text-white transition-transform duration-300 ease-in-out group-hover:rotate-45">
                <HugeiconsIcon icon={ArrowUpRight01Icon} size={16} />
              </span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
