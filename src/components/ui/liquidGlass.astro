---
interface Props {
  label?: string;
  href?: string;
  type?: "button" | "submit" | "reset";
  class?: string;
  ariaLabel?: string;
  target?: string;
  rel?: string;
  disabled?: boolean;
  id?: string;
  name?: string;
  value?: string;
  style?: string;
}

const {
  label = "Generate",
  href,
  type = "button",
  class: className = "",
  ariaLabel,
  target,
  rel,
  disabled = false,
  id,
  name,
  value,
  style,
} = Astro.props;

const safeRel = target === "_blank" ? rel ?? "noopener noreferrer" : rel;
---

<div class:list={["liquid-button-wrap", className]} style={style}>
  {
    href ? (
      <a
        id={id}
        href={disabled ? undefined : href}
        target={target}
        rel={safeRel}
        class:list={["liquid-button", disabled && "is-disabled"]}
        aria-label={ariaLabel ?? label}
        aria-disabled={disabled}
      >
        <span>
          <slot>{label}</slot>
        </span>
      </a>
    ) : (
      <button
        id={id}
        type={type}
        name={name}
        value={value}
        disabled={disabled}
        class="liquid-button"
        aria-label={ariaLabel ?? label}
      >
        <span>
          <slot>{label}</slot>
        </span>
      </button>
    )
  }

  <div class="liquid-button-shadow" aria-hidden="true"></div>
</div>

<style>
  @property --liquid-angle-1 {
    syntax: "<angle>";
    inherits: false;
    initial-value: -75deg;
  }

  @property --liquid-angle-2 {
    syntax: "<angle>";
    inherits: false;
    initial-value: -45deg;
  }

  .liquid-button-wrap {
    --liquid-button-size: 1rem;
    --liquid-hover-time: 400ms;
    --liquid-hover-ease: cubic-bezier(0.25, 1, 0.5, 1);

    position: relative;
    z-index: 2;
    display: inline-flex;
    border-radius: 999vw;
    background: transparent;
    font-size: var(--liquid-button-size);
    pointer-events: none;
    transition: all var(--liquid-hover-time) var(--liquid-hover-ease);
  }

  .liquid-button-shadow {
    --shadow-cutoff-fix: 2em;

    position: absolute;
    width: calc(100% + var(--shadow-cutoff-fix));
    height: calc(100% + var(--shadow-cutoff-fix));
    top: calc(0% - var(--shadow-cutoff-fix) / 2);
    left: calc(0% - var(--shadow-cutoff-fix) / 2);
    filter: blur(clamp(2px, 0.125em, 12px));
    overflow: visible;
    pointer-events: none;
  }

  .liquid-button-shadow::after {
    content: "";
    position: absolute;
    z-index: 0;
    inset: 0;
    border-radius: 999vw;
    background: linear-gradient(
      180deg,
      rgba(0, 0, 0, 0.2),
      rgba(0, 0, 0, 0.1)
    );
    width: calc(100% - var(--shadow-cutoff-fix) - 0.25em);
    height: calc(100% - var(--shadow-cutoff-fix) - 0.25em);
    top: calc(var(--shadow-cutoff-fix) - 0.5em);
    left: calc(var(--shadow-cutoff-fix) - 0.875em);
    padding: 0.125em;
    box-sizing: border-box;
    mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    mask-composite: exclude;
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    transition: all var(--liquid-hover-time) var(--liquid-hover-ease);
    opacity: 1;
  }

  .liquid-button {
    --border-width: clamp(1px, 0.0625em, 4px);

    all: unset;
    position: relative;
    z-index: 3;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    pointer-events: auto;
    border-radius: 999vw;
    background: linear-gradient(
      -75deg,
      rgba(255, 255, 255, 0.05),
      rgba(255, 255, 255, 0.2),
      rgba(255, 255, 255, 0.05)
    );
    box-shadow:
      inset 0 0.125em 0.125em rgba(0, 0, 0, 0.05),
      inset 0 -0.125em 0.125em rgba(255, 255, 255, 0.5),
      0 0.25em 0.125em -0.125em rgba(0, 0, 0, 0.2),
      0 0 0.1em 0.25em inset rgba(255, 255, 255, 0.2),
      0 0 0 0 rgba(255, 255, 255, 1);
    backdrop-filter: blur(clamp(1px, 0.125em, 4px));
    -webkit-backdrop-filter: blur(clamp(1px, 0.125em, 4px));
    -webkit-tap-highlight-color: transparent;
    text-decoration: none;
    transition: all var(--liquid-hover-time) var(--liquid-hover-ease);
  }

  .liquid-button:hover {
    transform: scale(0.975);
    backdrop-filter: blur(0.01em);
    -webkit-backdrop-filter: blur(0.01em);
    box-shadow:
      inset 0 0.125em 0.125em rgba(0, 0, 0, 0.05),
      inset 0 -0.125em 0.125em rgba(255, 255, 255, 0.5),
      0 0.15em 0.05em -0.1em rgba(0, 0, 0, 0.25),
      0 0 0.05em 0.1em inset rgba(255, 255, 255, 0.5),
      0 0 0 0 rgba(255, 255, 255, 1);
  }

  .liquid-button:focus-visible {
    outline: 2px solid rgba(0, 0, 0, 0.35);
    outline-offset: 4px;
  }

  .liquid-button:disabled,
  .liquid-button.is-disabled {
    cursor: not-allowed;
    opacity: 0.55;
    pointer-events: none;
  }

  .liquid-button span {
    position: relative;
    display: block;
    user-select: none;
    font-family:
      Inter,
      ui-sans-serif,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
    letter-spacing: -0.04em;
    font-weight: 500;
    font-size: 1em;
    line-height: 1;
    color: rgba(50, 50, 50, 1);
    text-shadow: 0 0.25em 0.05em rgba(0, 0, 0, 0.1);
    padding-inline: 1.5em;
    padding-block: 0.875em;
    transition: all var(--liquid-hover-time) var(--liquid-hover-ease);
  }

  .liquid-button:hover span {
    text-shadow: 0.025em 0.025em 0.025em rgba(0, 0, 0, 0.12);
  }

  .liquid-button span::after {
    content: "";
    position: absolute;
    z-index: 3;
    display: block;
    width: calc(100% - var(--border-width));
    height: calc(100% - var(--border-width));
    top: calc(0% + var(--border-width) / 2);
    left: calc(0% + var(--border-width) / 2);
    box-sizing: border-box;
    border-radius: 999vw;
    overflow: clip;
    background: linear-gradient(
      var(--liquid-angle-2),
      rgba(255, 255, 255, 0) 0%,
      rgba(255, 255, 255, 0.5) 40% 50%,
      rgba(255, 255, 255, 0) 55%
    );
    mix-blend-mode: screen;
    pointer-events: none;
    background-size: 200% 200%;
    background-position: 0% 50%;
    background-repeat: no-repeat;
    transition:
      background-position calc(var(--liquid-hover-time) * 1.25)
        var(--liquid-hover-ease),
      --liquid-angle-2 calc(var(--liquid-hover-time) * 1.25)
        var(--liquid-hover-ease);
  }

  .liquid-button:hover span::after {
    background-position: 25% 50%;
  }

  .liquid-button:active span::after {
    background-position: 50% 15%;
    --liquid-angle-2: -15deg;
  }

  .liquid-button::after {
    content: "";
    position: absolute;
    z-index: 1;
    border-radius: 999vw;
    width: calc(100% + var(--border-width));
    height: calc(100% + var(--border-width));
    top: calc(0% - var(--border-width) / 2);
    left: calc(0% - var(--border-width) / 2);
    padding: var(--border-width);
    box-sizing: border-box;
    background:
      conic-gradient(
        from var(--liquid-angle-1) at 50% 50%,
        rgba(0, 0, 0, 0.5),
        rgba(0, 0, 0, 0) 5% 40%,
        rgba(0, 0, 0, 0.5) 50%,
        rgba(0, 0, 0, 0) 60% 95%,
        rgba(0, 0, 0, 0.5)
      ),
      linear-gradient(
        180deg,
        rgba(255, 255, 255, 0.5),
        rgba(255, 255, 255, 0.5)
      );
    mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    mask-composite: exclude;
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    box-shadow: inset 0 0 0 calc(var(--border-width) / 2)
      rgba(255, 255, 255, 0.5);
    transition:
      all var(--liquid-hover-time) var(--liquid-hover-ease),
      --liquid-angle-1 500ms ease;
  }

  .liquid-button:hover::after {
    --liquid-angle-1: -125deg;
  }

  .liquid-button:active::after {
    --liquid-angle-1: -75deg;
  }

  .liquid-button-wrap:has(.liquid-button:hover) .liquid-button-shadow {
    filter: blur(clamp(2px, 0.0625em, 6px));
    transition: filter var(--liquid-hover-time) var(--liquid-hover-ease);
  }

  .liquid-button-wrap:has(.liquid-button:hover) .liquid-button-shadow::after {
    top: calc(var(--shadow-cutoff-fix) - 0.875em);
    opacity: 1;
  }

  .liquid-button-wrap:has(.liquid-button:active) {
    transform: rotate3d(1, 0, 0, 25deg);
  }

  .liquid-button-wrap:has(.liquid-button:active) .liquid-button {
    box-shadow:
      inset 0 0.125em 0.125em rgba(0, 0, 0, 0.05),
      inset 0 -0.125em 0.125em rgba(255, 255, 255, 0.5),
      0 0.125em 0.125em -0.125em rgba(0, 0, 0, 0.2),
      0 0 0.1em 0.25em inset rgba(255, 255, 255, 0.2),
      0 0.225em 0.05em 0 rgba(0, 0, 0, 0.05),
      0 0.25em 0 0 rgba(255, 255, 255, 0.75),
      inset 0 0.25em 0.05em 0 rgba(0, 0, 0, 0.15);
  }

  .liquid-button-wrap:has(.liquid-button:active) .liquid-button-shadow {
    filter: blur(clamp(2px, 0.125em, 12px));
  }

  .liquid-button-wrap:has(.liquid-button:active)
    .liquid-button-shadow::after {
    top: calc(var(--shadow-cutoff-fix) - 0.5em);
    opacity: 0.75;
  }

  .liquid-button-wrap:has(.liquid-button:active) span {
    text-shadow: 0.025em 0.25em 0.05em rgba(0, 0, 0, 0.12);
  }

  @media (hover: none) and (pointer: coarse) {
    .liquid-button span::after,
    .liquid-button:active span::after {
      --liquid-angle-2: -45deg;
    }

    .liquid-button::after,
    .liquid-button:hover::after,
    .liquid-button:active::after {
      --liquid-angle-1: -75deg;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .liquid-button-wrap,
    .liquid-button,
    .liquid-button span,
    .liquid-button span::after,
    .liquid-button::after,
    .liquid-button-shadow,
    .liquid-button-shadow::after {
      transition: none;
    }

    .liquid-button:hover {
      transform: none;
    }

    .liquid-button-wrap:has(.liquid-button:active) {
      transform: none;
    }
  }
</style>