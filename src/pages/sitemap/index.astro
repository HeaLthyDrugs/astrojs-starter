---
import Layout from "@/layouts/main.astro"
import { getCollection } from "astro:content"
import { FOOTER_QUICK_LINKS } from "@/lib/site"

const catalogItems = await getCollection("catalog")
---

<Layout
  seo={{
    title: "Sitemap | Cybotum",
    description:
      "Browse the main pages and catalog entries in the Cybotum starter template.",
    canonical: "/sitemap",
  }}
>
  <div class="mx-auto max-w-5xl px-4 py-16 sm:px-6 md:py-20">
    <article class="space-y-12">
      <header class="max-w-2xl">
        <span class="text-sm font-medium uppercase tracking-[0.16em] text-muted-foreground">
          Utility
        </span>
        <h1 class="mt-3 text-4xl font-bold tracking-tight md:text-5xl">Sitemap</h1>
        <p class="mt-4 text-base leading-7 text-muted-foreground md:text-lg">
          Use this page to quickly scan the main routes in the starter and jump to any catalog
          example you want to edit first.
        </p>
      </header>

      <section class="space-y-4">
        <h2 class="text-2xl font-semibold tracking-tight">Main pages</h2>
        <ul class="grid gap-3 sm:grid-cols-2">
          {FOOTER_QUICK_LINKS.map((link) => (
            <li>
              <a
                href={link.href}
                class="flex items-center justify-between rounded-2xl border border-border/70 bg-background px-4 py-3 text-sm font-medium text-foreground transition-colors hover:bg-muted"
              >
                <span>{link.label}</span>
                <span class="text-muted-foreground">→</span>
              </a>
            </li>
          ))}
          <li>
            <a
              href="/terms"
              class="flex items-center justify-between rounded-2xl border border-border/70 bg-background px-4 py-3 text-sm font-medium text-foreground transition-colors hover:bg-muted"
            >
              <span>Terms</span>
              <span class="text-muted-foreground">→</span>
            </a>
          </li>
          <li>
            <a
              href="/privacy"
              class="flex items-center justify-between rounded-2xl border border-border/70 bg-background px-4 py-3 text-sm font-medium text-foreground transition-colors hover:bg-muted"
            >
              <span>Privacy</span>
              <span class="text-muted-foreground">→</span>
            </a>
          </li>
        </ul>
      </section>

      <section class="space-y-4">
        <h2 class="text-2xl font-semibold tracking-tight">Catalog items</h2>
        <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {catalogItems.map((item) => (
            <li>
              <a
                href={`/catalog/${item.id}`}
                class="flex h-full flex-col rounded-2xl border border-border/70 bg-background p-4 transition-colors hover:bg-muted"
              >
                <span class="text-xs font-medium uppercase tracking-[0.16em] text-muted-foreground">
                  {item.data.category}
                </span>
                <span class="mt-2 text-base font-semibold tracking-tight text-foreground">
                  {item.data.title}
                </span>
                <span class="mt-2 text-sm leading-6 text-muted-foreground">
                  {item.data.shortDescription}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    </article>
  </div>
</Layout>
