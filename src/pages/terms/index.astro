---
import Layout from "@/layouts/main.astro"
import { SITE } from "@/lib/site"
---

<Layout
  seo={{
    title: "Terms | Cybotum",
    description:
      "Read the terms for using the Cybotum Astro starter template and its demo content.",
    canonical: "/terms",
  }}
>
  <div class="mx-auto max-w-4xl px-4 py-16 sm:px-6 md:py-20">
    <article class="space-y-10">
      <header class="max-w-2xl">
        <span class="text-sm font-medium uppercase tracking-[0.16em] text-muted-foreground">
          Legal
        </span>
        <h1 class="mt-3 text-4xl font-bold tracking-tight md:text-5xl">Terms of use</h1>
        <p class="mt-4 text-base leading-7 text-muted-foreground md:text-lg">
          These terms explain how this starter template can be used, customized, and shipped by
          buyers who adopt it for their own brand.
        </p>
      </header>

      <section class="space-y-3">
        <h2 class="text-2xl font-semibold tracking-tight">Template use</h2>
        <p class="text-sm leading-7 text-muted-foreground">
          {SITE.name} is provided as a frontend starter template. You may modify the layout,
          content, routing, metadata, and assets to fit your own project or client work.
        </p>
      </section>

      <section class="space-y-3">
        <h2 class="text-2xl font-semibold tracking-tight">Included assets</h2>
        <p class="text-sm leading-7 text-muted-foreground">
          Demo copy, placeholder illustrations, and sample catalog entries are included to help
          buyers launch quickly. Replace any branding that does not match your own product or
          agency before publishing.
        </p>
      </section>

      <section class="space-y-3">
        <h2 class="text-2xl font-semibold tracking-tight">No warranty</h2>
        <p class="text-sm leading-7 text-muted-foreground">
          This template is provided as-is, without guarantees of fitness for a specific use case.
          Buyers remain responsible for reviewing content, dependencies, integrations, and launch
          requirements.
        </p>
      </section>

      <section class="space-y-3">
        <h2 class="text-2xl font-semibold tracking-tight">Questions</h2>
        <p class="text-sm leading-7 text-muted-foreground">
          For questions about the template or the demo setup, contact{" "}
          <a href={`mailto:${SITE.email}`} class="font-medium text-primary underline-offset-4 hover:underline">
            {SITE.email}
          </a>
          .
        </p>
      </section>
    </article>
  </div>
</Layout>
