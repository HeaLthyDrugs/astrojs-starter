{
	"compatibility_date": "2026-06-11",
	"compatibility_flags": [
		"global_fetch_strictly_public"
	],
	"name": "astrostarter",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"kv_namespaces": [
		{
			"binding": "SESSION",
			"id": "7510e3f41e454950bd522a0ea0a256e5"
		}
	],
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	}
}
